# --- Server ---
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# --- Infrastructure (matches docker-compose.yml defaults) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scheduled_email
REDIS_URL=redis://localhost:6379

# --- Auth ---
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# --- SMTP (Ethereal). Run `npm run ethereal:create` or create an account at https://ethereal.email/create ---
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Scheduled Email App <your-ethereal-user@ethereal.email>"

# --- Worker ---
WORKER_CONCURRENCY=5
# Email throughput limit (enforced by BullMQ in Redis): at most MAX sends per DURATION
EMAIL_RATE_LIMIT_MAX=5
EMAIL_RATE_LIMIT_DURATION_MS=10000

# --- API rate limiting (per client IP, in-memory per API process) ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
SCHEDULE_RATE_LIMIT_MAX=60

# --- Reconciliation ---
RECONCILE_INTERVAL_MS=60000
STALE_PROCESSING_MS=120000
